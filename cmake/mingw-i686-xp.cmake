# Cross toolchain: Linux -> 32-bit Windows XP (MinGW-w64, posix threads)
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR i686)
set(CMAKE_SYSTEM_VERSION 5.1)
set(_tc i686-w64-mingw32)
find_program(CMAKE_C_COMPILER   NAMES ${_tc}-gcc-posix ${_tc}-gcc)
find_program(CMAKE_CXX_COMPILER NAMES ${_tc}-g++-posix ${_tc}-g++)
find_program(CMAKE_RC_COMPILER  NAMES ${_tc}-windres)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
# Windows XP SP2 = 0x0501 ; no SSE/AVX assumptions beyond what the user enables
set(XP_FLAGS "-D_WIN32_WINNT=0x0501 -DWINVER=0x0501 -DNTDDI_VERSION=0x05010300 -DGGML_WIN_VER=0x0501 -march=i686 -mtune=generic")
set(CMAKE_C_FLAGS_INIT   "${XP_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${XP_FLAGS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static -static-libgcc -static-libstdc++ -Wl,--major-os-version=5 -Wl,--minor-os-version=1 -Wl,--major-subsystem-version=5 -Wl,--minor-subsystem-version=1 -Wl,--large-address-aware")
